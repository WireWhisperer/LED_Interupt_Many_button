 21492     002B  0020               	banksel	23
 21493     002C  1417               	bsf	23,0	;关闭第 3 位(上一个)
 21494     002D  1097               	bcf	23,1	;选中第 1 位(位选)
 21495     002E  0096               	movwf	22	;段码输出到 LATA
 21496     002F  0AF5               	incf	select_place,f
 21497     0030  0009               	retfie
 21498     0031                     display_2:	
