 21583     007A                     i:
 21584     007A                     	ds	1
 21585     007B                     key_data:
 21586     007B                     	ds	1	;保存按下时 PORTC 低 4 位数据(供状态机比较)
 21587     007C                     key_cnt:
 21588     007C                     	ds	1	;按键状态机通用计数(进入各状态清零)
 21589     007D                     key_state:
 21590     007D                     	ds	1	;按键状态机状态(bit0-2=0~5, bit7=1 双击消抖)
