 21594 ;;=============== 主程序入口 ===============
 21595                           
 21596                           
 21597                           ;=============IO端口初始化=============
 21598                           ;关闭RABC模拟输入
 21599     0041  003E               	banksel	3896
 21600     0042  01B8               	clrf	3896	;关闭 RA 口的模拟功能
 21601     0043  003E               	banksel	3907
 21602     0044  01C3               	clrf	3907	;关闭 RB 口的模拟功能
 21603     0045  003E               	banksel	3918
 21604     0046  01CE               	clrf	3918	;关闭 RC 口的模拟功能
 21605                           
 21606                           ;PORTA 初始化：全设为数字输出
 21607     0047  0020               	banksel	22
 21608     0048  0196               	clrf	22	;RA 输出锁存清零
 21609     0049  0191               	clrf	17	;RA 全部设为输出
 21610                           
 21611                           ;PORTB 初始化：低 4 位(LED/位选)输出，高 3 位输入
 21612     004A  0197               	clrf	23	;RB 输出锁存清零
 21613     004B  30E0               	movlw	224	;bit7-5=1 输入, bit4-0=0 输出(0LED 1234)
 21614     004C  0092               	movwf	18
 21615                           
 21616                           ;PORTC 初始化：低 4 位弱上拉输入(实时监测电平)，高 4 位输出
 21617     004D  0198               	clrf	24	;RC 输出锁存清零
 21618     004E  0020               	banksel	19
 21619     004F  300F               	movlw	15	;bit0-3=输入, bit4-7=输出
 21620     0050  0093               	movwf	19
 21621     0051  003E               	banksel	3919
 21622     0052  300F               	movlw	15	;bit0-3=弱上拉使能
 21623     0053  00CF               	movwf	3919
 21624                           
 21625                           ;=============定时器初始化=============
 21626                           ;时钟：HFINTOSC 设为 4MHz
 21627     0054  0031               	banksel	2195
 21628     0055  3002               	movlw	2
 21629     0056  0093               	movwf	2195
 21630                           
 21631                           ;Timer0 配置
 21632     0057  0020               	banksel	30
 21633     0058  019E               	clrf	30	;先停止 Timer0，稍后启动
 21634     0059  0020               	banksel	31
 21635     005A  3040               	movlw	64
 21636     005B  009F               	movwf	31	;T0CS=010(FOSC/4), ((T0CON1) and 07Fh), 4, T0CKPS=0000(1:1) → 定时基准
 21637                           
 21638                           ;===============中断初始化====================
 21639                           ;中断在变量初始化完成后开启
 21640     005C  0020               	banksel	11
 21641     005D  018B               	clrf	11
 21642                           
 21643                           ;中断使能：TMR0 中断 + 外部 INT 中断
 21644     005E  002E               	banksel	1814
 21645     005F  0196               	clrf	1814
 21646     0060  1696               	bsf	1814,5	;((PIE0) and 07Fh), 5 使能
 21647     0061  1416               	bsf	1814,0	;INTE：外部中断使能
 21648     0062  128C               	bcf	1804,5	;清除 TMR0 标志
 21649     0063  003D               	banksel	3728
 21650     0064  300D               	movlw	13
 21651     0065  0090               	movwf	3728	;外部中断引脚映射 (INT 接到指定引脚)
 21652                           
 21653                           ;启动 Timer0 (16位模式)
 21654     0066  0020               	banksel	30
 21655     0067  3090               	movlw	144
 21656     0068  009E               	movwf	30
 21657                           
 21658                           ;======================变量初始化===========================
 21659                           ;变量初始化：显示初值 px=0，select_place=0
 21660     0069  3000               	movlw	0
 21661     006A  00F1               	movwf	p1
 21662     006B  3000               	movlw	0
 21663     006C  00F2               	movwf	p2
 21664     006D  3000               	movlw	0
 21665     006E  00F3               	movwf	p3
 21666     006F  3000               	movlw	0
 21667     0070  00F4               	movwf	p4
 21668     0071  01F5               	clrf	select_place
 21669     0072  01F8               	clrf	cur_bit
 21670     0073  01F9               	clrf	prev_bit
 21671     0074  01F6               	clrf	sys_tick
 21672     0075  01F7               	clrf	sys_tick+1
 21673     0076  01FD               	clrf	key_state	;状态机从 KEY_IDLE 开始
 21674     0077  01FC               	clrf	key_cnt
 21675                           
 21676                           ;--- 清除中断标志，再开启中断 ---
 21677     0078  002E               	banksel	1804
 21678     0079  018C               	clrf	1804	;清所有中断标志
 21679     007A  0020               	banksel	11
 21680     007B  170B               	bsf	11,6	;((INTCON) and 07Fh), 6 Enable 外设中断使能
 21681     007C  178B               	bsf	11,7	;((INTCON) and 07Fh), 7 Enable 全局中断使能
 21682     007D                     main_loop:	
 21683                           ;===============主循环================
 21684                           ;按键扫描+状态机已移入 TMR0 中断(每次中断采样一次)
 21685                           
 21686     007D  287D               	goto	main_loop	;空循环
 21687     007E                     tick_divider:	
 21688                           ;--- 软件分频器：sys_tick 第8位 0→1 上升沿检测 → 触发 tick8_handler ---
 21689                           
 21690     007E  0876               	movf	sys_tick,w
 21691     007F  3980               	andlw	128
 21692     0080  00F8               	movwf	cur_bit	; 当前第8位
 21693     0081  0679               	xorwf	prev_bit,w	; W = 当前^上次
 21694     0082  1903               	btfsc	3,2
 21695     0083  2887               	goto	tick_checked	; 无变化
 21696     0084  1FF8               	btfss	cur_bit,7	; 当前位(bit7)=1 才是 0→1 上升沿
 21697     0085  2887               	goto	tick_checked
 21698     0086  2089               	call	tick_handler	; 触发函数
 21699     0087                     tick_checked:
 21700     0087  0878               	movf	cur_bit,w
 21701     0088  00F9               	movwf	prev_bit	; 更新上次值
 21702     0089                     tick_handler:	
 21703                           ;--- sys_tick 第8位 0→1 上升沿触发的函数 ---
 21704                           
 21705     0089  0AF1               	incf	p1,f
 21706     008A  3024               	movlw	36	; 36
 21707     008B  0671               	xorwf	p1,w
 21708     008C  1903               	btfsc	3,2
 21709     008D  01F1               	clrf	p1	; p1==36 时回到 0(保持 0~35)
 21710     008E  0008               	return
 21711     008F                     handle_int:	
 21712                           ;按键处理
 21713                           
 21714     008F  0AF2               	incf	p2,f
 21715     0090  0008               	return
 21716     0091                     button_scan:
 21717     0091  087D               	movf	key_state,w
 21718     0092  1903               	btfsc	3,2	;key_state==KEY_IDLE(0) → 重新扫描矩阵
 21719     0093  2895               	goto	scan_matrix
 21720     0094  28D4               	goto	State_machine	;非空闲 → 直接进状态机
 21721     0095                     scan_matrix:	
 21722                           ;--- 矩阵扫描(仅空闲时进入) ---
 21723                           
 21724     0095  3004               	movlw	4
 21725     0096  00FA               	movwf	i
 21726     0097  003E               	banksel	3919
 21727     0098  300F               	movlw	15	;bit0-3弱上拉输入，bit4-7输出
 21728     0099  00CF               	movwf	3919
 21729     009A  0020               	banksel	19
 21730     009B  300F               	movlw	15	;bit0-3弱上拉输入，bit4-7输出
 21731     009C  0093               	movwf	19
 21732     009D  080E               	movf	14,w	;读取按键电平(按下=0)
 21733     009E  390F               	andlw	15	;只保留低 4 位
 21734     009F                     cal_0_num:	
 21735                           ;========= 统计 PORTC 低 i 位中 0 的个数 → 分支 =========
 21736                           ; i = 扫描位数(1~4)；按键按下时对应位为 0
 21737                           ; 0 的个数(即按下的按键数)：
 21738                           ; 0 个 → 无按键 → no_zero
 21739                           ; 1 个 → 单键按下 → one_zero
 21740                           ; ≥2 个 → 多键按下 → to_many_zero
 21741                           ;
 21742                           ; 算法：nz = mask ^ v (对低 i 位取反)，nz 中 1 的个数 = 零的个数
 21743                           ; nz == 0 → 无零(低 i 位全 1)
 21744                           ; nz 恰好 1 位为 1 → 一个零 (nz≠0 且 (nz&(nz-1))==0)
 21745                           ; 否则 → 多个零
 21746                           
 21747                           
 21748                           ;--- 1) 保存 v，并按 i 查表得到掩码 mask=(1<<i)-1 ---
 21749                           ; 注意：不能用 retlw(它会 RETURN 提前退出本函数)，改为跳转+汇合
 21750     009F  00F0               	movwf	charcase	;charcase = v(PORTC 低 4 位)
 21751     00A0  087A               	movf	i,w	;i 须在 1~4
 21752     00A1  3EFF               	addlw	-1	;W = i-1 (0~3)
 21753     00A2  000B               	brw
 21754     00A3  28A7               	goto	mask_i1
 21755     00A4  28A9               	goto	mask_i2
 21756     00A5  28AB               	goto	mask_i3
 21757     00A6  28AD               	goto	mask_i4
 21758     00A7                     mask_i1:
 21759     00A7  3001               	movlw	1	;i=1 → 掩码 0b0001
 21760     00A8  28AE               	goto	mask_done
 21761     00A9                     mask_i2:
 21762     00A9  3003               	movlw	3	;i=2 → 掩码 0b0011
 21763     00AA  28AE               	goto	mask_done
 21764     00AB                     mask_i3:
 21765     00AB  3007               	movlw	7	;i=3 → 掩码 0b0111
 21766     00AC  28AE               	goto	mask_done
 21767     00AD                     mask_i4:
 21768     00AD  300F               	movlw	15	;i=4 → 掩码 0b1111
 21769     00AE                     mask_done:
 21770                           
 21771                           ;--- 2) nz = mask ^ v ---
 21772     00AE  0670               	xorwf	charcase,w	;W = mask ^ v = nz
 21773                           
 21774                           ;--- 3) 按 nz 中 1 的个数分支 ---
 21775     00AF  00F0               	movwf	charcase	;charcase = nz
 21776     00B0  0870               	movf	charcase,w
 21777     00B1  1903               	btfsc	3,2	;nz==0 → 无零(低 i 位全 1)
 21778     00B2  28B8               	goto	no_zero
 21779     00B3  0370               	decf	charcase,w	;W = nz-1
 21780     00B4  0570               	andwf	charcase,w	;W = nz & (nz-1)
 21781     00B5  1903               	btfsc	3,2	;Z=1 → nz 为 2 的幂(恰好 1 位) → 一个零
 21782     00B6  28CC               	goto	one_zero
 21783     00B7  28C3               	goto	to_many_zero	;否则 → 多个零
 21784     00B8                     no_zero:
 21785                           
 21786                           ;--- 无按键：TRISC/WPUC 逻辑右移切到下一列，i-1 ---
 21787                           ; i != 0 → 重新读 PORTC 再统计下一列(不能沿用 W 残留值!)
 21788                           ; i == 0 → 4 列扫完无按键 → 返回
 21789     00B8  0020               	banksel	19
 21790     00B9  3693               	lsrf	19,f	;TRISC 逻辑右移(扫描列切换)
 21791     00BA  003E               	banksel	3919
 21792     00BB  36CF               	lsrf	3919,f	;WPUC 逻辑右移(跟上 TRISC)
 21793     00BC  0BFA               	decfsz	i,f	;i = i-1；结果为 0 时跳过下一条
 21794     00BD  28BF               	goto	scan_next	;i != 0 → 重新读 PORTC
 21795     00BE  0008               	return	;i == 0 → 扫完所有列，返回
 21796     00BF                     scan_next:
 21797                           
 21798                           ;右移后必须重新读 PORTC(此时 W 是统计残留值, 不能当 v 用)
 21799     00BF  0020               	banksel	14
 21800     00C0  080E               	movf	14,w
 21801     00C1  390F               	andlw	15
 21802     00C2  289F               	goto	cal_0_num	;重新统计下一列
 21803     00C3                     to_many_zero:
 21804                           
 21805                           ;--- 多个按键同时按下 → 4 位显示 "Err"(末位熄灭) 并返回 ---
 21806     00C3  300E               	movlw	14	;索引 14 = 'E'
 21807     00C4  00F1               	movwf	p1
 21808     00C5  301B               	movlw	27	;索引 27 = 'R'(表内无小写 r，用 R 近似)
 21809     00C6  00F2               	movwf	p2
 21810     00C7  301B               	movlw	27	;索引 27 = 'R'
 21811     00C8  00F3               	movwf	p3
 21812     00C9  3024               	movlw	36	;索引 36 = 全灭(第 4 位熄灭)
 21813     00CA  00F4               	movwf	p4
 21814     00CB  0008               	return
 21815     00CC                     one_zero:
 21816                           
 21817                           ;--- 单键按下：保存本次 PORTC 数据，直接进入消抖状态 ---
 21818     00CC  0020               	banksel	14
 21819     00CD  080E               	movf	14,w	;重新读 PORTC(此时 charcase 已被覆盖为 nz)
 21820     00CE  390F               	andlw	15
 21821     00CF  00FB               	movwf	key_data	;保存按下时的 PORTC 低 4 位
 21822     00D0  01FC               	clrf	key_cnt	;按下次数清零(从按下时刻开始计数)
 21823     00D1  3001               	movlw	(0+1)	;直接进入消抖(替代原 FLAG 标记)
 21824     00D2  00FD               	movwf	key_state
 21825     00D3  0008               	return
 21826                           
 21827                           ;--- 按键状态机常量：key_state 的 01 组合区分状态 ---
 21828                           ; bit0-2 = 状态(0~5, 共6个节点), bit7=1 → 消抖为二次(双击)模式
 21829                           ; KEY_DEBOUNCE 被复用两次(首次→DOWN, 二次→DOUBLE_ACTIVE)
 21830     0000                     KEY_IDLE        equ	0
 21831     0001                     KEY_DEBOUNCE    equ	1
 21832     0002                     KEY_DOWN        equ	2
 21833     0003                     KEY_LONG_ACTIVE equ	3
 21834     0004                     KEY_WAIT_DOUBLE equ	4
 21835     0005                     KEY_DOUBLE_ACTIVE equ	5
 21836     00D4                     State_machine:	
 21837                           ;--- 按键状态机：单击/双击/长按 ---
 21838                           ; 入口：button_scan 判断 key_state 非空闲(KEY_IDLE)时直接跳这里
 21839                           ; 采样：PORTC 低4位任一为 0 → 按键仍按下(具体按键见 key_data)
 21840                           ; 计数：key_cnt 为通用计数(进入各状态清零)
 21841                           ; 事件：WAIT_DOUBLE 第129次超时→单击；进 LONG_ACTIVE→长按；进 DOUBLE_ACTIVE→双
      +                          击
 21842                           ; 结束：回到 KEY_IDLE → 从头开始扫描
 21843                           
 21844     00D4  0020               	banksel	14
 21845     00D5  080E               	movf	14,w
 21846     00D6  390F               	andlw	15
 21847     00D7  00F0               	movwf	charcase	;charcase = v(PORTC 低4位)
 21848                           
 21849                           ;按当前 i 只保留扫描层有效位(低 i 位), 忽略被 TRISC 右移成输出的高位
 21850                           ; 有效位全1(无按下)→差值为0,Z=1; 有0(按下)→差值非0,Z=0
 21851     00D8  2154               	call	key_mask	;W = mask
 21852     00D9  00F8               	movwf	cur_bit	;cur_bit = mask
 21853     00DA  0870               	movf	charcase,w
 21854     00DB  0578               	andwf	cur_bit,w	;W = v & mask (有效位)
 21855     00DC  0278               	subwf	cur_bit,w	;W = mask - (v&mask)
 21856     00DD  00F0               	movwf	charcase	;charcase = 差值(各状态用它判断按下/松开)
 21857                           
 21858                           ;按低3位状态分支
 21859     00DE  087D               	movf	key_state,w
 21860     00DF  3907               	andlw	7
 21861     00E0  000B               	brw
 21862     00E1  28E7               	goto	st_idle	;0 KEY_IDLE
 21863     00E2  28E8               	goto	st_debounce	;1 KEY_DEBOUNCE
 21864     00E3  28FE               	goto	st_down	;2 KEY_DOWN
 21865     00E4  2909               	goto	st_long_active	;3 KEY_LONG_ACTIVE
 21866     00E5  2917               	goto	st_wait_double	;4 KEY_WAIT_DOUBLE
 21867     00E6  2924               	goto	st_double_active	;5 KEY_DOUBLE_ACTIVE
 21868     00E7                     st_idle:	
 21869                           ;--- KEY_IDLE：空闲。现由 one_zero 直接转入 KEY_DEBOUNCE，此状态不可达，仅占位 
      +                          ---
 21870                           
 21871     00E7  0008               	return
 21872     00E8                     st_debounce:	
 21873                           ;--- KEY_DEBOUNCE(复用)：连续3次按下才有效；<3次回IDLE ---
 21874                           
 21875     00E8  0870               	movf	charcase,w
 21876     00E9  1903               	btfsc	3,2	;松开 → 消抖失败回 IDLE
 21877     00EA  28FA               	goto	debounce_fail
 21878     00EB  0AFC               	incf	key_cnt,f
 21879     00EC  3003               	movlw	3
 21880     00ED  027C               	subwf	key_cnt,w	;W = 3 - key_cnt
 21881     00EE  1D03               	btfss	3,2	;未满3次
 21882     00EF  0008               	return
 21883                           
 21884                           ;连续3次按下 → 按 bit7 区分去向
 21885     00F0  1FFD               	btfss	key_state,7	;bit7=1 → 二次(双击)消抖
 21886     00F1  28F6               	goto	debounce_to_down
 21887     00F2  3005               	movlw	5	;二次消抖成功 → 双击激活
 21888     00F3  00FD               	movwf	key_state
 21889     00F4  01FC               	clrf	key_cnt
 21890     00F5  293C               	goto	trigger_double
 21891     00F6                     debounce_to_down:
 21892     00F6  3002               	movlw	2	;首次消抖成功 → 按下状态
 21893     00F7  00FD               	movwf	key_state
 21894     00F8  01FC               	clrf	key_cnt
 21895     00F9  0008               	return
 21896     00FA                     debounce_fail:
 21897     00FA  3000               	movlw	0
 21898     00FB  00FD               	movwf	key_state
 21899     00FC  01FC               	clrf	key_cnt
 21900     00FD  0008               	return
 21901     00FE                     st_down:	
 21902                           ;--- KEY_DOWN：按下保持。连续256次→长按；松开→等待双击 ---
 21903                           
 21904     00FE  0870               	movf	charcase,w
 21905     00FF  1903               	btfsc	3,2	;松开
 21906     0100  2905               	goto	down_release
 21907     0101  0AFC               	incf	key_cnt,f
 21908     0102  1903               	btfsc	3,2	;key_cnt 255→0(第256次) → 长按
 21909     0103  2937               	goto	trigger_long
 21910     0104  0008               	return
 21911     0105                     down_release:
 21912     0105  01FC               	clrf	key_cnt
 21913     0106  3004               	movlw	4
 21914     0107  00FD               	movwf	key_state
 21915     0108  0008               	return
 21916     0109                     st_long_active:	
 21917                           ;--- KEY_LONG_ACTIVE：长按已触发。连续3次松开→回IDLE ---
 21918                           
 21919     0109  0870               	movf	charcase,w
 21920     010A  1D03               	btfss	3,2	;仍按下 → 重置松开计数
 21921     010B  2915               	goto	long_still_pressed
 21922     010C  0AFC               	incf	key_cnt,f
 21923     010D  3003               	movlw	3
 21924     010E  027C               	subwf	key_cnt,w
 21925     010F  1D03               	btfss	3,2
 21926     0110  0008               	return
 21927     0111  3000               	movlw	0	;连续3次松开 → 回待机
 21928     0112  00FD               	movwf	key_state
 21929     0113  01FC               	clrf	key_cnt
 21930     0114  0008               	return
 21931     0115                     long_still_pressed:
 21932     0115  01FC               	clrf	key_cnt
 21933     0116  0008               	return
 21934     0117                     st_wait_double:	
 21935                           ;--- KEY_WAIT_DOUBLE：等待双击窗口。128次内再按下→二次消抖；第129次未按下�
      +                          �单击 ---
 21936                           
 21937     0117  0870               	movf	charcase,w
 21938     0118  1D03               	btfss	3,2	;检测到再次按下
 21939     0119  2920               	goto	wait_double_pressed
 21940     011A  0AFC               	incf	key_cnt,f	;窗口计数 +1
 21941     011B  3081               	movlw	129
 21942     011C  027C               	subwf	key_cnt,w
 21943     011D  1903               	btfsc	3,2	;第129次仍未按下 → 超时单击
 21944     011E  2932               	goto	trigger_click
 21945     011F  0008               	return
 21946     0120                     wait_double_pressed:
 21947     0120  01FC               	clrf	key_cnt
 21948     0121  3081               	movlw	129	;二次消抖(bit7=1)
 21949     0122  00FD               	movwf	key_state
 21950     0123  0008               	return
 21951     0124                     st_double_active:	
 21952                           ;--- KEY_DOUBLE_ACTIVE：双击已触发。连续3次松开→回IDLE ---
 21953                           
 21954     0124  0870               	movf	charcase,w
 21955     0125  1D03               	btfss	3,2
 21956     0126  2930               	goto	double_still_pressed
 21957     0127  0AFC               	incf	key_cnt,f
 21958     0128  3003               	movlw	3
 21959     0129  027C               	subwf	key_cnt,w
 21960     012A  1D03               	btfss	3,2
 21961     012B  0008               	return
 21962     012C  3000               	movlw	0	;连续3次松开 → 回待机
 21963     012D  00FD               	movwf	key_state
 21964     012E  01FC               	clrf	key_cnt
 21965     012F  0008               	return
 21966     0130                     double_still_pressed:
 21967     0130  01FC               	clrf	key_cnt
 21968     0131  0008               	return
 21969     0132                     trigger_click:	
 21970                           ;--- 单击事件(WAIT_DOUBLE 第129次超时) ---
 21971                           
 21972     0132  213F               	call	click_event
 21973     0133  3000               	movlw	0
 21974     0134  00FD               	movwf	key_state
 21975     0135  01FC               	clrf	key_cnt
 21976     0136  0008               	return
 21977     0137                     trigger_long:	
 21978                           ;--- 长按事件(第256次按下) ---
 21979                           
 21980     0137  214D               	call	long_event
 21981     0138  3003               	movlw	3
 21982     0139  00FD               	movwf	key_state
 21983     013A  01FC               	clrf	key_cnt
 21984     013B  0008               	return
 21985     013C                     trigger_double:	
 21986                           ;--- 双击事件(二次消抖成功) ---
 21987                           
 21988     013C  2146               	call	double_event
 21989                           
 21990                           ;key_state 已是 KEY_DOUBLE_ACTIVE
 21991     013D  01FC               	clrf	key_cnt
 21992     013E  0008               	return
 21993     013F                     click_event:	
 21994                           ;--- 单击事件处理：1、2位=按键号, 3、4位=DJ(单击) ---
 21995                           
 21996     013F  215B               	call	key_number	;W = 按键号(1~10)
 21997     0140  217A               	call	disp_key_num	;p1=十位(0全灭), p2=个位
 21998     0141  300D               	movlw	13	;'D'
 21999     0142  00F3               	movwf	p3
 22000     0143  3013               	movlw	19	;'J'
 22001     0144  00F4               	movwf	p4
 22002     0145  0008               	return
 22003     0146                     double_event:	
 22004                           ;--- 双击事件处理：1、2位=按键号, 3、4位=SJ(双击) ---
 22005                           
