 21418                           ;--- 判断中断源 1：外部中断 INT (PIR0 bit0) ---
 21419                           
 21420 ;;=============== 中断服务程序 ISR ===============
 21421     0004  002E               	banksel	1804	;4us
 21422     0005  1C0C               	btfss	1804,0	;IF=1 是外部中断 → 顺序执行；IF=0 跳到 TMR0 处理
 21423     0006  280A               	goto	TMR0_OP
 21424     0007  100C               	bcf	1804,0	;清除外部中断标志
 21425                           
 21426                           ;--- 外部中断处理： ---
 21427     0008  208F               	call	handle_int
 21428     0009  0009               	retfie
 21429     000A                     TMR0_OP:	
 21430                           ;--- 判断中断源 2：定时器 TMR0 溢出 (PIR0 bit5 / ((PIR0) and 07Fh), 5) ---
 21431                           
 21432     000A  002E               	banksel	1804
 21433     000B  1E8C               	btfss	1804,5	;((PIR0) and 07Fh), 5=1 是 TMR0 中断；否则非本程序中断，直接返回
 21434     000C  0009               	retfie
 21435     000D  128C               	bcf	1804,5	;清除 TMR0 中断标志
 21436                           
 21437                           ;--- 16 位系统时钟 +1 (低字节回绕时高字节进位) ---
 21438     000E  0AF6               	incf	sys_tick,f
 21439     000F  1903               	btfsc	3,2	;低字节从 FF→00 回绕时 Z=1 → 高字节进位
 21440     0010  0AF7               	incf	sys_tick+1,f
 21441                           
 21442                           ;重装 TMR0 初值
 21443     0011  0020               	banksel	29
 21444     0012  30FB               	movlw	251	;重装值高8位(汇编器自动算出)
 21445     0013  009D               	movwf	29
 21446     0014  301E               	movlw	30	;重装值低8位(汇编器自动算出)
 21447     0015  009C               	movwf	28
 21448                           
 21449                           ;--- 按键扫描 + 状态机：每次 TMR0 中断调用一次(约5ms 采样一次) ---
 21450                           ; 识别 10 个按键的单击/双击/长按；同时按下两个键 → 显示 "Err"
 21451     0016  2091               	call	button_scan
 21452                           
 21453                           ;========根据位选变量值跳转到相应显示过程=========
 21454                           ;当位选值大于3时清零
 21455     0017  0875               	movf	select_place,w
 21456     0018  3903               	andlw	3
 21457     0019  00F5               	movwf	select_place
 21458     001A  1CF5               	btfss	select_place,1
 21459                           
 21460                           ;这里是0和1
 21461     001B  281F               	goto	first_two
 21462                           
 21463                           ;这里是2和3
 21464     001C  1C75               	btfss	select_place,0
 21465                           
 21466                           ;这里是2
 21467     001D  2831               	goto	display_2
 21468                           
 21469                           ;这里是3
 21470     001E  2839               	goto	display_3
 21471     001F                     first_two:
 21472     001F  1875               	btfsc	select_place,0
 21473                           
 21474                           ;这里是1
 21475     0020  2829               	goto	display_1
 21476                           
 21477                           ;这里是0
 21478                           ;======= 第 1 位显示刷新 =======
 21479     0021  0871               	movf	p1,w
 21480     0022  219E               	call	seg_table	;值(0~35) → 段码
 21481     0023  0020               	banksel	23
 21482     0024  1597               	bsf	23,3	;关闭第 3 位(上一个)
 21483     0025  1017               	bcf	23,0	;选中第 1 位(位选)
 21484     0026  0096               	movwf	22	;段码输出到 LATA
 21485     0027  0AF5               	incf	select_place,f
 21486     0028  0009               	retfie
 21487     0029                     display_1:	
 21488                           ;======= 第 2 位显示刷新 =======
