 21523 ;;--- XC8 汇编器标准段声明(样板，勿删) ---
 21524 ;;--- 系统参数常量(EQU)：编译期自动计算 TMR0 重装值 ---
 21525 ;; 实际公式推导:
 21526 ;; FOSC(指令时钟) = HFINTOSC / 4 → 1MHz
 21527 ;; TMR0 输入时钟 = FOSC / 4 = HFINTOSC / 16 → 250kHz
 21528 ;; (硬件: T0CS=FOSC/4(1MHz) × T0CKPS=1:4)
 21529 ;; 4 位数码管动态扫描 → 定时器溢出频率 = 刷新率 × 4 → 200Hz
 21530 ;; (2^16 - 重装值) = TMR0输入时钟 / 溢出频率 = 250000/200 = 1250
 21531 ;; → 重装值及其高/低8位全部由汇编器在编译期自动算出
 21532 ;;
 21533 ;; 刷新率取值范围(受 16 位重装值限制, 重装值须在 0~65535 内):
 21534 ;; 重装值 = 65536 - 250000/(刷新率×4)
 21535 ;; → 最小值: 刷新率 = 250000/(65536×4) ≈ 0.95Hz (重装值=0, 满量程 65536 个计数)
 21536 ;; → 最大值: 刷新率 = 250000/(1×4) = 62500Hz (重装值=65535, 每周期只计 1 个)
 21537 ;; → 实用推荐: 30~500Hz (常见 50~120Hz)
 21538   3D0900                     HFINTOSC        equ	4000000	; 系统振荡频率 4MHz
 21539    F4240                     FOSC            equ	1000000	; 指令时钟 = HFINTOSC/4 = 1MHz
 21540     0032                     DISP_REFRESH    equ	50	; 4 位数码管刷新率(Hz, 整屏扫一遍)
 21541     0004                     DISP_DIGITS     equ	4	; 数码管位数(动态扫描)
 21542    3D090                     TMR0_CLK        equ	250000	; TMR0 输入时钟 = FOSC/4 = 250kHz
 21543     00C8                     TMR0_OVF        equ	200	; 溢出频率 = 刷新率×4 = 200Hz
 21544     04E2                     TMR0_TICKS      equ	1250	; 每周期计数个数 1250
 21545     FB1E                     TMR0_RELOAD     equ	64286	; 16 位重装值
 21546     00FB                     TMR0_RELOAD_H   equ	251	; 高 8 位(HIGH 操作符, 自动算出)
 21547     001E                     TMR0_RELOAD_L   equ	30	; 低 8 位(LOW 操作符, 自动算出)
 21548     0000                     reset_vec:	
 21549 ;;--- 复位向量：上电/复位后从 reset_vec 跳转到 _main ---
 21550                           
 21551     0000  3180  2841  3180   	ljmp	_main
 21552                           
